# Copy to .env and fill in. Restart Vite after changes.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:5000/api

# Optional: if the browser URL differs from what you added under Supabase → Auth → Redirect URLs
# (e.g. you use http://127.0.0.1:5173 but only http://localhost:5173 is allowlisted), set:
# VITE_AUTH_EMAIL_REDIRECT_ORIGIN=http://localhost:5173
