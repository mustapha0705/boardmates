generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GameStatus {
  pending
  in_review
  completed
}

enum ChessPlatform {
  chess_com
  lichess
}

enum PlayerColor {
  white
  black
}

enum GameResult {
  win
  lose
  draw
}

model User {
  id             String         @id @default(uuid()) @db.Uuid
  email          String         @unique
  displayName    String         @map("display_name")
  chessUsername  String?        @unique @map("chess_username")
  chessPlatform  ChessPlatform? @map("chess_platform")
  rapidRating    Int?           @map("rapid_rating")
  createdAt      DateTime       @default(now()) @map("created_at")

  authoredGames  Game[]          @relation("GameAuthor")
  reviewedGames  Game[]          @relation("GameReviewer")
  reviewComments ReviewComment[]

  @@map("users")
}

model Game {
  id            String     @id @default(uuid()) @db.Uuid
  authorId      String     @map("author_id") @db.Uuid
  reviewerId    String?    @map("reviewer_id") @db.Uuid
  title         String
  pgn           String
  status        GameStatus @default(pending)
  isPrivate     Boolean    @default(false) @map("is_private")
  timeControl   String     @map("time_control")
  /// Which side the submitter played
  playerColor   PlayerColor? @map("player_color")
  /// Submitter's result (win / lose / draw)
  gameResult    GameResult?  @map("game_result")
  averageRating Int?       @map("average_rating")
  reviewNotes   String?    @map("review_notes")
  /// Minified JSON string of the full move tree (Text avoids Prisma Json deep-validation "recursion limit" on large trees)
  analysisTree  String?    @map("analysis_tree") @db.Text
  createdAt     DateTime   @default(now()) @map("created_at")
  claimedAt     DateTime?  @map("claimed_at")
  completedAt   DateTime?  @map("completed_at")

  author   User  @relation("GameAuthor", fields: [authorId], references: [id])
  reviewer User? @relation("GameReviewer", fields: [reviewerId], references: [id])

  comments ReviewComment[]

  @@map("games")
}

model ReviewComment {
  id         String   @id @default(uuid()) @db.Uuid
  gameId     String   @map("game_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  ply        Int
  san        String?
  comment    String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  game     Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reviewer User @relation(fields: [reviewerId], references: [id])

  @@unique([gameId, ply, san])
  @@map("review_comments")
}
